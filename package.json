{
  "name": "ferupis-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "workspaces": [
    "apps/ferupis-qwik",
    "packages/*",
    "packages/qwik-core/src/backend/workers/*"
  ],
  "scripts": {
    "dev:f": "npm run dev --workspace @apps/ferupis-qwik -- --port 5176 --host 0.0.0.0",
    "build:f": "npm run build --workspace @apps/ferupis-qwik",
    "cf:dev:f": "npm run build:f && node scripts/run-ferupis-pages-dev.mjs",
    "cf:dev:common-worker": "npm run dev --workspace @workers/common-worker",
    "cf:dry-run:common-worker:dev": "wrangler deploy --config packages/qwik-core/src/backend/workers/common-worker/wrangler.jsonc --env= --dry-run",
    "cf:dry-run:common-worker:preview": "wrangler deploy --config packages/qwik-core/src/backend/workers/common-worker/wrangler.jsonc --env preview --dry-run",
    "cf:dry-run:common-worker:prod": "wrangler deploy --config packages/qwik-core/src/backend/workers/common-worker/wrangler.jsonc --env production --dry-run",
    "types:cloudflare:check:common-worker": "npm run types.cloudflare.check --workspace @workers/common-worker",
    "script:pics": "tsc -p scripts/ts/tsconfig.json && node --experimental-strip-types scripts/ts/dist/scripts/ts/src/pics.js",
    "script:pics:upscale": "tsc -p scripts/ts/tsconfig.json && node --experimental-strip-types scripts/ts/dist/scripts/ts/src/upscale-pics.js",
    "script:pics:review": "tsc -p scripts/ts/tsconfig.json && node --experimental-strip-types scripts/ts/dist/scripts/ts/src/review-pics.js",
    "script:pics:restored-sync": "node scripts/ts/src/sync-restored-pics.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giuliomarinelli/Ferupis.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/giuliomarinelli/Ferupis/issues"
  },
  "homepage": "https://github.com/giuliomarinelli/Ferupis#readme",
  "description": "",
  "overrides": {
    "vite-imagetools": "10.0.1"
  },
  "devDependencies": {
    "@types/node": "20.19.0",
    "sharp": "0.35.3",
    "wrangler": "4.124.0"
  }
}
