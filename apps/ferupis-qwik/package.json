{
  "name": "@apps/ferupis-qwik",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "exports": {
    "./pics": "./src/media/pics/index.ts"
  },
  "scripts": {
    "prebuild": "npm run generate.breadcrumbs",
    "build": "qwik build",
    "prebuild.client": "npm run generate.breadcrumbs",
    "build.client": "vite build",
    "prebuild.preview": "npm run generate.breadcrumbs",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "prebuild.server": "npm run generate.breadcrumbs",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.ts",
    "prebuild.types": "npm run generate.breadcrumbs",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "npm run build && wrangler pages deploy",
    "predev": "npm run generate.breadcrumbs",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "generate.breadcrumbs": "node --experimental-strip-types scripts/generate-breadcrumbs.mjs",
    "start": "vite --open --mode ssr",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test.e2e": "playwright test",
    "e2e.serve": "wrangler pages dev --ip 127.0.0.1 --port 8790 --persist-to ../../.wrangler/e2e",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@builder.io/qwik": "1.20.0",
    "@builder.io/qwik-city": "1.20.0",
    "@playwright/test": "1.62.1",
    "@eslint/js": "9",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "20.19.0",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "1.20.0",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "tailwindcss": "4.1.11",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "undici": "*",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "4.2.1",
    "@gm/qwik-core": "0.1.0"
  }
}
